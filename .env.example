# ============================================================
# LensCare — Environment Variables
# Copy this file to .env.local and fill in the values
# NEVER commit .env.local to version control
# ============================================================

# ---- Supabase -----------------------------------------------
# Project URL from Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon/public key (safe for browser) — Supabase Dashboard > API > Project API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key (NEVER expose to browser — server-side only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---- Database (Prisma via Supabase) -------------------------
# Transaction pooler URL — Supabase Dashboard > Project Settings > Database > Connection string
# Mode: Transaction (port 6543) — for Prisma in serverless
DATABASE_URL=postgresql://postgres.your-project-id:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct connection URL — for Prisma migrations
# Mode: Direct (port 5432) — Supabase Dashboard > Database > Connection string
DIRECT_URL=postgresql://postgres.your-project-id:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# ---- Site URL -----------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=8801XXXXXXXXX

# ---- SSLCommerz (Bangladesh Payment Gateway) ----------------
SSLCOMMERZ_STORE_ID=your-sslcommerz-store-id
SSLCOMMERZ_STORE_PASSWORD=your-sslcommerz-store-password
# Set to "true" for production, "false" for sandbox
SSLCOMMERZ_IS_LIVE=false

# ---- Resend (Email) -----------------------------------------
RESEND_API_KEY=re_your-resend-api-key
RESEND_FROM_EMAIL=noreply@lenscare.com.bd

# ---- Admin --------------------------------------------------
# The email address that gets ADMIN role on first login
ADMIN_EMAIL=admin@lenscare.com.bd
